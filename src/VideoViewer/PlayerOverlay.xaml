<UserControl x:Class="VideoViewer.PlayerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root">
        <!-- Dimmed backdrop: click outside the video to close -->
        <Border x:Name="Backdrop" Background="#E0050609" MouseLeftButtonDown="Backdrop_MouseDown" />

        <Grid x:Name="VideoFrame" Margin="40,64,40,36" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="FrameScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Border x:Name="FrameShadow" Background="Black" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="80" ShadowDepth="0" Opacity="0.9" Color="Black" />
                </Border.Effect>
            </Border>
            <Border x:Name="FrameGlow" Margin="-1" CornerRadius="7" BorderThickness="1" Opacity="0.45"
                    BorderBrush="{StaticResource AccentGradient}" IsHitTestVisible="False" />

            <vlc:VideoView x:Name="Video" Background="Black">
                <!-- Everything in here floats above the native video surface -->
                <Grid x:Name="Chrome" Background="#01000000" Focusable="True" FocusVisualStyle="{x:Null}"
                      MouseMove="Chrome_MouseMove" MouseWheel="Chrome_MouseWheel">

                    <Border x:Name="HitLayer" Background="#01000000" MouseLeftButtonDown="HitLayer_MouseDown" />

                    <!-- center: spinner / flash / error -->
                    <Grid IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="Spinner" Width="56" Height="56" Visibility="Collapsed">
                            <Ellipse Stroke="#30FFFFFF" StrokeThickness="4" />
                            <Ellipse Stroke="White" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinRotate" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <Border x:Name="FlashBadge" Width="88" Height="88" CornerRadius="44" Background="#99000000" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FlashScale" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="FlashGlyph" Style="{StaticResource Glyph}" FontSize="32" Foreground="White" Text="&#xE768;" />
                        </Border>

                        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="40" Foreground="#FFB4B4" />
                            <TextBlock Text="Couldn't play this file" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock x:Name="ErrorDetail" Foreground="#B3FFFFFF" FontSize="13" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                                       Text="The file may be damaged or still being copied." />
                        </StackPanel>
                    </Grid>

                    <!-- controls -->
                    <Grid x:Name="ControlsLayer">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- top bar -->
                        <Grid x:Name="TopBar">
                            <Border Height="120" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#C0000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="24,16,14,0" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                               FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="InfoText" Foreground="#B0FFFFFF" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="RevealButton" Style="{StaticResource PlayerButton}" Content="&#xE838;" ToolTip="Show in folder" Click="Reveal_Click" />
                                    <Button Style="{StaticResource PlayerButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="Close_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- bottom bar -->
                        <Grid x:Name="BottomBar" Grid.Row="2">
                            <Border Height="170" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#D0000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="22,0,22,14" VerticalAlignment="Bottom">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TimeText" Text="0:00" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" MinWidth="44" />
                                    <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource FancySlider}" Minimum="0" Maximum="1"
                                            Margin="10,0" VerticalAlignment="Center" ValueChanged="Seek_ValueChanged" />
                                    <TextBlock x:Name="LengthText" Grid.Column="2" Text="0:00" Foreground="#B0FFFFFF" FontSize="12.5"
                                               VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SpeedButton" Style="{StaticResource PlayerTextButton}" Content="1×" ToolTip="Playback speed" Click="Speed_Click" />
                                        <Button x:Name="LoopButton" Style="{StaticResource PlayerButton}" Content="&#xE8EE;" ToolTip="Loop (L)" Click="Loop_Click" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PrevButton" Style="{StaticResource PlayerButton}" Content="&#xE892;" ToolTip="Previous video (PgUp)" Click="Prev_Click" />
                                        <Button Style="{StaticResource PlayerButton}" Content="&#xEB9E;" ToolTip="Back 10s (←)" Click="Back_Click" Margin="6,0" />
                                        <Button x:Name="PlayButton" Style="{StaticResource BigPlayButton}" Content="&#xE769;" ToolTip="Play / Pause (Space)" Click="Play_Click" Margin="6,0" />
                                        <Button Style="{StaticResource PlayerButton}" Content="&#xEB9D;" ToolTip="Forward 10s (→)" Click="Forward_Click" Margin="6,0" />
                                        <Button x:Name="NextButton" Style="{StaticResource PlayerButton}" Content="&#xE893;" ToolTip="Next video (PgDn)" Click="Next_Click" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="MuteButton" Style="{StaticResource PlayerButton}" Content="&#xE767;" ToolTip="Mute (M)" Click="Mute_Click" />
                                        <Slider x:Name="VolumeSlider" Style="{StaticResource FancySlider}" Width="96" Minimum="0" Maximum="100" Value="80"
                                                VerticalAlignment="Center" Margin="2,0,10,0" ValueChanged="Volume_ValueChanged" />
                                        <Button x:Name="FullscreenButton" Style="{StaticResource PlayerButton}" Content="&#xE740;" ToolTip="Full screen (F)" Click="Fullscreen_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </vlc:VideoView>
        </Grid>
    </Grid>
</UserControl>
