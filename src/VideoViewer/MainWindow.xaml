<Window x:Class="VideoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoViewer"
        Title="Video Viewer" Width="1380" Height="880" MinWidth="860" MinHeight="540"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:SixteenNineConverter x:Key="SixteenNine" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ===== Video card ===== -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Margin="9" CornerRadius="14" Background="{StaticResource SurfaceBrush}" Cursor="Hand"
                    BorderThickness="1" BorderBrush="#10FFFFFF" RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonDown="Card_MouseDown" MouseLeftButtonUp="Card_MouseUp" MouseRightButtonUp="Card_RightClick">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 16:9 thumbnail area -->
                    <Grid x:Name="ThumbArea" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SixteenNine}}">
                        <!-- placeholder -->
                        <Border CornerRadius="13,13,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#1C2130" />
                                    <GradientStop Offset="1" Color="#141824" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="26" Foreground="#2E3546" />
                        </Border>
                        <!-- the thumbnail (ImageBrush keeps the rounded corners) -->
                        <Border x:Name="Pic" CornerRadius="13,13,0,0" Opacity="0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill">
                                    <ImageBrush.RelativeTransform>
                                        <ScaleTransform CenterX="0.5" CenterY="0.5" />
                                    </ImageBrush.RelativeTransform>
                                </ImageBrush>
                            </Border.Background>
                        </Border>
                        <!-- bottom shade -->
                        <Border CornerRadius="13,13,0,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0.55" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#73000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- hover play button -->
                        <Border x:Name="PlayBadge" Width="52" Height="52" CornerRadius="26" Background="#E6FFFFFF" Opacity="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                            </Border.RenderTransform>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="20" Foreground="#0A0C11" Margin="3,0,0,0" />
                        </Border>
                        <!-- top-left badges -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsHitTestVisible="False">
                            <Border Background="#99000000" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="{Binding Extension}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E6FFFFFF" />
                            </Border>
                            <Border Background="{StaticResource AccentGradient}" CornerRadius="6" Padding="6,2" Margin="5,0,0,0"
                                    Visibility="{Binding HasQualityBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding QualityBadge}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <!-- duration -->
                        <Border Background="#B3000000" CornerRadius="6" Padding="7,2" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                            <TextBlock Text="{Binding DurationText}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </Grid>

                    <!-- caption -->
                    <StackPanel Grid.Row="1" Margin="13,10,13,12">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DateText, Mode=OneWay}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Pic" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Pic" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#808B6CFF" />
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Surface2Brush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Pic" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Pic" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="Pic" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Pic" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.7" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.7" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Row of cards (rows are what get virtualized) ===== -->
        <DataTemplate x:Key="RowTemplate">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}" Margin="15,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- ================= Shell (library) ================= -->
        <Grid x:Name="ShellGrid" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="#151A24" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Grid Width="28" Height="28">
                            <Border CornerRadius="8" Background="{StaticResource AccentGradient}" Opacity="0.55">
                                <Border.Effect>
                                    <BlurEffect Radius="14" />
                                </Border.Effect>
                            </Border>
                            <Image Source="Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock Text="Video Viewer" FontFamily="{StaticResource DisplayFont}" FontSize="15.5" FontWeight="SemiBold"
                                   Margin="11,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="14,0,14,16">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="LIBRARY" Margin="6,10,0,8" />
                            <ToggleButton x:Name="AllNav" Style="{StaticResource NavItem}" IsChecked="True" Click="AllNav_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B9;" FontSize="15" Margin="2,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="All videos" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AllCount" Grid.Column="2" Text="0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel x:Name="FolderList" />
                            <Button Style="{StaticResource GhostButton}" Click="AddFolder_Click" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="11" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <TextBlock Text="Add folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="FILTERS" Margin="6,10,0,0" />
                                <Button x:Name="ResetFiltersButton" Style="{StaticResource GhostButton}" Padding="8,3" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Content="Reset" FontSize="12" Visibility="Collapsed" Click="ResetFilters_Click" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="Type" FontSize="12" FontWeight="Normal" Foreground="{StaticResource SubTextBrush}" Margin="6,12,0,8" />
                            <WrapPanel x:Name="TypeChips" Margin="4,0,0,0" />
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Length" FontSize="12" FontWeight="Normal" Foreground="{StaticResource SubTextBrush}" Margin="6,10,0,8" />
                            <WrapPanel x:Name="LengthChips" Margin="4,0,0,0" />
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Shape" FontSize="12" FontWeight="Normal" Foreground="{StaticResource SubTextBrush}" Margin="6,10,0,8" />
                            <WrapPanel x:Name="ShapeChips" Margin="4,0,0,0" />
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Date" FontSize="12" FontWeight="Normal" Foreground="{StaticResource SubTextBrush}" Margin="6,10,0,8" />
                            <WrapPanel x:Name="DateChips" Margin="4,0,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- status -->
                    <Border Grid.Row="2" Margin="14,0,14,14" Padding="12,10" CornerRadius="10" Background="#0CFFFFFF" x:Name="StatusBox" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Accent2Brush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="1" Margin="24,10,22,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeadingText" Text="All videos" FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CountText" Text="" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="1,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SortButton" Style="{StaticResource PillButton}" Click="Sort_Click" ToolTip="Sort">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" FontSize="13" Margin="0,0,9,0" Foreground="{StaticResource SubTextBrush}" />
                                <TextBlock x:Name="SortText" Text="Newest first" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="9,1,0,0" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Button>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="10" Height="38" Margin="10,0,0,0" Padding="12,0" ToolTip="Thumbnail size (Ctrl + / Ctrl −)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE80A;" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <Slider x:Name="SizeSlider" Style="{StaticResource FancySlider}" Width="110" Minimum="170" Maximum="460" Value="260"
                                        Margin="10,0" VerticalAlignment="Center" ValueChanged="SizeSlider_ValueChanged" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE739;" FontSize="14" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0" ToolTip="Rescan folders (F5)" Click="Rescan_Click" />
                    </StackPanel>
                </Grid>

                <!-- grid of videos -->
                <ItemsControl x:Name="VideoGrid" Grid.Row="2" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,2"
                              ScrollViewer.CanContentScroll="True" SizeChanged="VideoGrid_SizeChanged">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="PART_Scroller" CanContentScroll="True" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,2,0,28">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- empty library -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60" Visibility="Collapsed">
                    <Grid Width="112" Height="112" HorizontalAlignment="Center">
                        <Border CornerRadius="30" Background="{StaticResource AccentGradient}" Opacity="0.6" Margin="8">
                            <Border.Effect>
                                <BlurEffect Radius="44" />
                            </Border.Effect>
                        </Border>
                        <Image Source="Assets/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <TextBlock Text="Your videos, all in one place" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,26,0,8" />
                    <TextBlock Text="Attach a folder and every video inside it shows up here — and stays in sync as files change."
                               Foreground="{StaticResource SubTextBrush}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" />
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,26,0,0" Click="AddFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Add a folder" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="or drag folders onto this window" Foreground="{StaticResource MutedTextBrush}" FontSize="12.5"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>

                <!-- no results -->
                <StackPanel x:Name="NoResults" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="34" Foreground="#3A4357" />
                    <TextBlock Text="No videos match" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="Try a different search or loosen the filters." Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource PillButton}" Content="Clear search &amp; filters" HorizontalAlignment="Center" Margin="0,18,0,0" Click="ClearAll_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= Player ================= -->
        <local:PlayerOverlay x:Name="Player" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- ================= Caption bar (stays on top) ================= -->
        <Grid x:Name="CaptionBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SearchHost" Grid.Column="1" HorizontalAlignment="Left" Width="460" Margin="24,0,0,0" VerticalAlignment="Center"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search videos   (Ctrl+F)" TextChanged="SearchBox_TextChanged" />
                <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                        HorizontalAlignment="Right" Margin="0,0,5,0" Visibility="Collapsed" Click="ClearSearch_Click" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="CloseWindow_Click" />
            </StackPanel>
        </Grid>

        <!-- drop target hint -->
        <Border x:Name="DropHint" Grid.RowSpan="2" Margin="18" CornerRadius="18" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}"
                Background="#D90A0C11" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="48" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Drop to add to your library" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="Folders are added and watched · Videos play right away" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- toast -->
        <Border x:Name="Toast" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="#F01D2330" BorderBrush="#2E3647" BorderThickness="1" CornerRadius="12" Padding="16,10" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="13" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                <TextBlock x:Name="ToastText" FontSize="13" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
